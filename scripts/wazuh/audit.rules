## D2 edge-Pi auditd rules for Wazuh (audit-keys CDB compatible)
## Installed by scripts/install-wazuh-agent.sh -> /etc/audit/rules.d/wazuh.rules
## Same as the VM ruleset EXCEPT: no `-S execve` command-logging rules -- on a Pi
## running 30s container healthchecks that is thousands of events/day with no
## signal (the manager already demotes rule 80792 to level 0).

## Delete existing rules
-D

## Buffer & failure mode
-b 8192
-f 1

## File write/read/attribute monitoring -> keys: audit-wazuh-w, audit-wazuh-r, audit-wazuh-a
-w /etc/passwd -p wa -k audit-wazuh-w
-w /etc/shadow -p wa -k audit-wazuh-w
-w /etc/group -p wa -k audit-wazuh-w
-w /etc/sudoers -p wa -k audit-wazuh-w
-w /etc/sudoers.d/ -p wa -k audit-wazuh-w
-w /etc/ssh/sshd_config -p wa -k audit-wazuh-w
-w /etc/ssh/ -p wa -k audit-wazuh-w
-w /etc/crontab -p wa -k audit-wazuh-w
-w /etc/cron.d/ -p wa -k audit-wazuh-w
-w /etc/cron.hourly/ -p wa -k audit-wazuh-w
-w /etc/cron.daily/ -p wa -k audit-wazuh-w
-w /etc/cron.weekly/ -p wa -k audit-wazuh-w
-w /etc/cron.monthly/ -p wa -k audit-wazuh-w
-w /var/spool/cron/ -p wa -k audit-wazuh-w

## Privilege escalation tracking -> key: audit-wazuh-x
-w /usr/bin/sudo -p x -k audit-wazuh-x
-w /usr/bin/su -p x -k audit-wazuh-x

## User/group management
-w /usr/sbin/useradd -p x -k audit-wazuh-x
-w /usr/sbin/userdel -p x -k audit-wazuh-x
-w /usr/sbin/groupadd -p x -k audit-wazuh-x
-w /usr/sbin/groupdel -p x -k audit-wazuh-x

## Module loading -> key: audit-wazuh-w
-w /sbin/insmod -p x -k audit-wazuh-w
-w /sbin/rmmod -p x -k audit-wazuh-w
-w /sbin/modprobe -p x -k audit-wazuh-w
