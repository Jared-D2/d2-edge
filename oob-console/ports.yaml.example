# Per-site console map. Copy to ports.yaml (gitignored) and edit.
# slot N ↔ /dev/d2-console/slotNN ↔ TCP 300N. Port :3000 lists all slots.
#
# Each slot needs exactly ONE of:
#   usb_serial: the adapter's unique serial — the slot then follows the
#               adapter to ANY USB port or hub position (preferred).
#               FLEET STANDARD: buy FTDI-based adapters (unique serials).
#               Find it:  udevadm info -q property /dev/ttyUSBx | grep ID_SERIAL_SHORT
#   usb_path:   the physical USB port (for serial-less CH340s / non-unique
#               CP2102s) — slot identity = the labelled port; moving the
#               cable requires editing this file.
#               Find it:  udevadm info -q property /dev/ttyUSBx | grep ID_PATH=
#
# After editing: sudo bash /opt/d2-edge/shared/scripts/update.sh
# (hotplugging an adapter later is picked up automatically)
slots:
  - slot: 1
    device: ncm-fgt01        # log filename + Graylog field, [A-Za-z0-9._-]
    baud: 9600
    platform: fortigate
    usb_serial: A50285BI
  - slot: 2
    device: ncm-cx01
    baud: 115200
    platform: aruba-cx
    usb_path: platform-fd500000.usb-usb-0:1.2:1.0
