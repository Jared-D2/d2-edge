    listen {
        type = auth
        ipaddr = *
        port = 2083
        proto = tcp

        limit {
            max_connections = 16
            lifetime = 0
            idle_timeout = 30
        }

        tls {
            private_key_file = /opt/etc/raddb/certs/radsec/radsec.key
            certificate_file = /opt/etc/raddb/certs/radsec/radsec.crt
            ca_file = /opt/etc/raddb/certs/radsec/ca-bundle.pem
            fragment_size = 8192
            cipher_list = "HIGH"
            cipher_server_preference = yes
            tls_min_version = "1.2"
            tls_max_version = "1.3"
            # Server-side TLS only (decided 2026-07-15): clients like AOS-CX
            # present a self-signed device cert, so we do not require client
            # certs. Access to 2083 is gated by the subnet-scoped client blocks.
            # NB: the former "require_cert = yes" here was a silent no-op --
            # FreeRADIUS 3 only knows require_client_cert.
            require_client_cert = no
        }
    }
